diff --git a/README.md b/README.md
index e6db896..e5782fd 100644
--- a/README.md
+++ b/README.md
@@ -97,6 +97,8 @@ option is specified (delete, summarize, link, dedupe, etc.)
  -1 --one-file-system   do not match files on different filesystems/devices
  -A --no-hidden         exclude hidden files from consideration
  -B --dedupe            do a copy-on-write (reflink/clone) deduplication
+ -c --dedupe-copy-range dedupe with copy_file_range(), assuming the FS does
+                        a CoW clone (e.g. ZFS block cloning across datasets)
  -C --chunk-size=#      override I/O chunk size; valid range is 0-18.
                         Use '-C help' for detailed chunk size help
  -d --delete            prompt user for files to preserve and delete all
diff --git a/act_dedupefiles.c b/act_dedupefiles.c
index e8d83b4..97b7c9a 100644
--- a/act_dedupefiles.c
+++ b/act_dedupefiles.c
@@ -1,6 +1,11 @@
 /* Deduplication of files with OS-specific copy-on-write mechanisms
  * This file is part of jdupes; see jdupes.c for license information */
 
+/* copy_file_range() requires _GNU_SOURCE */
+#if defined __linux__ && !defined _GNU_SOURCE
+ #define _GNU_SOURCE
+#endif
+
 #include "jdupes.h"
 
 #ifdef ENABLE_DEDUPE
@@ -11,6 +16,7 @@
 #include <stdlib.h>
 #include <stdint.h>
 #include <string.h>
+#include <sys/stat.h>
 #include <unistd.h>
 
 #include "act_dedupefiles.h"
@@ -32,6 +38,7 @@
  #include <sys/ioctl.h>
  #define JDUPES_DEDUPE_SUPPORTED 1
  #define KERNEL_DEDUP_MAX_SIZE 16777216
+ #define COPY_RANGE_MAX_SIZE 1073741824
  /* Error messages */
  static const char s_err_dedupe_notabug[] = "This is not a bug in jdupes; check your file stats/permissions.";
  static const char s_err_dedupe_repeated[] = "This verbose error description will not be repeated.";
@@ -168,4 +175,131 @@ void dedupefiles(file_t * restrict files)
 #endif /* __APPLE__ */
   return;
 }
+
+
+#ifdef __linux__
+/* "Copy" duplicates over each other with copy_file_range(), assuming that
+ * the filesystem performs a CoW block clone instead of a real copy (ZFS block
+ * cloning only works across datasets this way). Unlike FIDEDUPERANGE, the
+ * kernel does NOT verify that the data is identical, so the caller must have
+ * done a full byte-for-byte match confirmation. */
+void dedupefiles_copyrange(file_t * restrict files)
+{
+  file_t *curfile, *curfile2, *dupefile;
+  int src_fd, dest_fd;
+  int err_eighteen = 0;
+  uint64_t total_files = 0;
+
+  LOUD(fprintf(stderr, "\ndedupefiles_copyrange: %p\n", files);)
+
+  for (curfile = files; curfile; curfile = curfile->next) {
+    /* Skip all files that have no duplicates */
+    if (!ISFLAG(curfile->flags, FF_HAS_DUPES)) continue;
+    CLEARFLAG(curfile->flags, FF_HAS_DUPES);
+
+    /* For each duplicate list head, handle the duplicates in the list */
+    curfile2 = curfile;
+    src_fd = open(curfile->d_name, O_RDONLY);
+    /* If an open fails, keep going down the dupe list until it is exhausted */
+    while (src_fd == -1 && curfile2->duplicates && curfile2->duplicates->duplicates) {
+      fprintf(stderr, "dedupe: open failed (skipping): %s\n", curfile2->d_name);
+      exit_status = EXIT_FAILURE;
+      curfile2 = curfile2->duplicates;
+      src_fd = open(curfile2->d_name, O_RDONLY);
+    }
+    if (src_fd == -1) continue;
+    printf("  [SRC] %s\n", curfile2->d_name);
+
+    /* Run copy_file_range for each set */
+    for (dupefile = curfile->duplicates; dupefile; dupefile = dupefile->duplicates) {
+      struct stat dest_stat;
+      struct timespec times[2];
+      off_t src_off, dest_off, remain;
+      ssize_t ret = 0;
+
+      if (dupefile == curfile2) continue;
+
+      /* Don't copy over hard links to the source */
+      if (dupefile->device == curfile2->device && dupefile->inode == curfile2->inode) {
+        printf("  -==-> %s\n", dupefile->d_name);
+        continue;
+      }
+
+      /* The kernel won't compare data, so refuse to write if anything changed */
+      if (file_has_changed(curfile2)) {
+        fprintf(stderr, "error: source file modified since scanned, skipping set: %s\n", curfile2->d_name);
+        exit_status = EXIT_FAILURE;
+        break;
+      }
+      if (file_has_changed(dupefile)) {
+        printf("  -XX-> %s\n", dupefile->d_name);
+        fprintf(stderr, "error: target file modified since scanned, not deduping\n");
+        exit_status = EXIT_FAILURE;
+        continue;
+      }
+
+      /* Open destination file, skipping any that fail */
+      dest_fd = open(dupefile->d_name, O_WRONLY);
+      if (dest_fd == -1) {
+        fprintf(stderr, "dedupe: open failed (skipping): %s\n", dupefile->d_name);
+        exit_status = EXIT_FAILURE;
+        continue;
+      }
+      /* Save timestamps; writing to the file will change them */
+      if (fstat(dest_fd, &dest_stat) != 0) {
+        fprintf(stderr, "dedupe: fstat failed (skipping): %s\n", dupefile->d_name);
+        exit_status = EXIT_FAILURE;
+        close(dest_fd);
+        continue;
+      }
+
+      /* Clone src --> dest, 1 GiB or less at a time */
+      src_off = 0;
+      dest_off = 0;
+      remain = dupefile->size;
+      errno = 0;
+      while (remain > 0) {
+        ret = copy_file_range(src_fd, &src_off, dest_fd, &dest_off,
+            (size_t)(remain <= COPY_RANGE_MAX_SIZE ? remain : COPY_RANGE_MAX_SIZE), 0);
+        if (ret <= 0) break;
+        remain -= (off_t)ret;
+      }
+
+      /* Handle any errors */
+      if (remain != 0) {
+        printf("  -XX-> %s\n", dupefile->d_name);
+        if (ret == 0) fprintf(stderr, "error: source file ended early (modified during dedupe?)\n");
+        else fprintf(stderr, "error: %s (%d)\n", strerror(errno), errno);
+        exit_status = EXIT_FAILURE;
+        if (errno == EXDEV && err_eighteen == 0) {
+          fprintf(stderr, "       One or more files are on filesystems that the kernel will not\n");
+          fprintf(stderr, "       copy_file_range() between (different filesystems or ZFS pools?)\n");
+          fprintf(stderr, "       %s\n", s_err_dedupe_notabug);
+          fprintf(stderr, "       %s\n", s_err_dedupe_repeated);
+          err_eighteen = 1;
+        }
+      } else {
+        /* Dedupe OK; report to the user and add to file count */
+        printf("  ====> %s\n", dupefile->d_name);
+        total_files++;
+      }
+
+      /* Restore the original timestamps */
+      times[0] = dest_stat.st_atim;
+      times[1] = dest_stat.st_mtim;
+      if (futimens(dest_fd, times) != 0) {
+        fprintf(stderr, "warning: failed to restore timestamps: %s\n", dupefile->d_name);
+        exit_status = EXIT_FAILURE;
+      }
+      close(dest_fd);
+    }
+    printf("\n");
+    close(src_fd);
+    total_files++;
+  }
+
+  if (!ISFLAG(flags, F_HIDEPROGRESS)) fprintf(stderr, "Deduplication done (%" PRIuMAX " files processed)\n", total_files);
+  return;
+}
+#endif /* __linux__ */
 #endif /* ENABLE_DEDUPE */
