@@ -10,6 +10,9 @@ extern "C" {
 
 #include "jdupes.h"
 void dedupefiles(file_t * restrict files);
+#ifdef __linux__
+void dedupefiles_copyrange(file_t * restrict files);
+#endif
 
 #ifdef __cplusplus
 }
diff --git a/dumpflags.c b/dumpflags.c
index ddc1d23..f758ca3 100644
--- a/dumpflags.c
+++ b/dumpflags.c
@@ -48,6 +48,7 @@ void dump_all_flags(void)
   if (ISFLAG(a_flags, FA_PRINTNULL)) fprintf(stderr, " FA_PRINTNULL");
   if (ISFLAG(a_flags, FA_PRINTJSON)) fprintf(stderr, " FA_PRINTJSON");
   if (ISFLAG(a_flags, FA_ERRORONDUPE)) fprintf(stderr, " FA_ERRORONDUPE");
+  if (ISFLAG(a_flags, FA_DEDUPECOPYRANGE)) fprintf(stderr, " FA_DEDUPECOPYRANGE");
 
   /* Extra print flags */
   if (ISFLAG(p_flags, PF_PARTIAL)) fprintf(stderr, " PF_PARTIAL");
diff --git a/helptext.c b/helptext.c
index a719144..c8173fa 100644
--- a/helptext.c
+++ b/helptext.c
@@ -103,6 +103,10 @@ void help_text(void)
   printf(" -A --no-hidden    \texclude hidden files from consideration\n");
 #ifdef ENABLE_DEDUPE
   printf(" -B --dedupe      \tdo a copy-on-write (reflink/clone) deduplication\n");
+ #ifdef __linux__
+  printf(" -c --dedupe-copy-range\tdedupe with copy_file_range(), assuming the FS does\n");
+  printf("                  \ta CoW clone (e.g. ZFS block cloning across datasets)\n");
+ #endif
 #endif
 #ifndef NO_CHUNKSIZE
   printf(" -C --chunk-size=#\toverride I/O chunk size; valid range is 0-18.\n");
diff --git a/jdupes.1 b/jdupes.1
index 670954f..213f468 100644
--- a/jdupes.1
+++ b/jdupes.1
@@ -41,6 +41,14 @@ data deduplication on disk (known as copy-on-write, CoW, cloning, or
 reflink); only a few filesystems support this (BTRFS; XFS when mkfs.xfs
 was used with -m crc=1,reflink=1; Apple APFS)
 .TP
+.B -c --dedupe-copy-range
+(Linux only) use copy_file_range() to copy each duplicate's source file over
+it, assuming that the filesystem performs a copy-on-write block clone rather
+than a real copy; this is needed for ZFS block cloning across datasets. The
+kernel does not verify that the data is identical, so a full byte-for-byte
+comparison is always done first. If the filesystem does not clone, the data
+is really copied (the contents still match, but no space is saved).
+.TP
 .B -C --chunk-size=\fIsize-number\fR
 override I/O chunk size; jdupes tunes this automatically but if you have large
 files on mechanical hard drives, large chunks may reduce seek time penalties
diff --git a/jdupes.c b/jdupes.c
index 790827f..8690ab7 100644
--- a/jdupes.c
+++ b/jdupes.c
@@ -193,6 +193,7 @@ int main(int argc, char **argv)
     { "no-hidden", 0, 0, 'A' },
     { "dedupe", 0, 0, 'B' },
     { "hash-db-opts", 1, 0, 'b' },
+    { "dedupe-copy-range", 0, 0, 'c' },
     { "chunk-size", 1, 0, 'C' },
     { "debug", 0, 0, 'D' },
     { "delete", 0, 0, 'd' },
@@ -237,7 +238,7 @@ int main(int argc, char **argv)
  #define GETOPT getopt
 #endif
 
-#define GETOPT_STRING "@019ABb:C:DdEefHhIijKLlMmNnOo:P:pQqRrSsTtUuVvX:Yy:Zz"
+#define GETOPT_STRING "@019ABb:cC:DdEefHhIijKLlMmNnOo:P:pQqRrSsTtUuVvX:Yy:Zz"
 
   /* Verify libjodycode compatibility before going further */
   if (libjodycode_version_check(1, 0) != 0) {
@@ -327,6 +328,14 @@ int main(int argc, char **argv)
       CLEARFLAG(flags, F_INCLUDEEMPTY);
       LOUD(fprintf(stderr, "opt: CoW/block-level deduplication enabled (--dedupe)\n");)
       break;
+#ifdef __linux__
+    case 'c':
+      /* The kernel does not compare data, so F_QUICKCOMPARE must NOT be set */
+      SETFLAG(a_flags, FA_DEDUPECOPYRANGE);
+      CLEARFLAG(flags, F_INCLUDEEMPTY);
+      LOUD(fprintf(stderr, "opt: copy_file_range() CoW deduplication enabled (--dedupe-copy-range)\n");)
+      break;
+#endif /* __linux__ */
 #endif /* ENABLE_DEDUPE */
 #ifndef NO_HASHDB
     case 'b':
@@ -625,10 +634,11 @@ skip_partialonly_noise:
       !!ISFLAG(a_flags, FA_PRINTJSON) +
       !!ISFLAG(a_flags, FA_PRINTUNIQUE) +
       !!ISFLAG(a_flags, FA_ERRORONDUPE) +
-      !!ISFLAG(a_flags, FA_DEDUPEFILES);
+      !!ISFLAG(a_flags, FA_DEDUPEFILES) +
+      !!ISFLAG(a_flags, FA_DEDUPECOPYRANGE);
 
   if (pm > 1) {
-      fprintf(stderr, "Only one of --summarize, --print-summarize, --delete, --link-hard,\n--link-soft, --json, --error-on-dupe, or --dedupe may be used\n");
+      fprintf(stderr, "Only one of --summarize, --print-summarize, --delete, --link-hard,\n--link-soft, --json, --error-on-dupe, --dedupe, or --dedupe-copy-range may be used\n");
       exit(EXIT_FAILURE);
   }
   if (pm == 0) SETFLAG(a_flags, FA_PRINTMATCHES);
@@ -839,6 +849,9 @@ skip_file_scan:
 #endif /* NO_HARDLINKS */
 #ifdef ENABLE_DEDUPE
   if (ISFLAG(a_flags, FA_DEDUPEFILES)) dedupefiles(files);
+ #ifdef __linux__
+  if (ISFLAG(a_flags, FA_DEDUPECOPYRANGE)) dedupefiles_copyrange(files);
+ #endif /* __linux__ */
 #endif /* ENABLE_DEDUPE */
   if (ISFLAG(a_flags, FA_PRINTMATCHES)) printmatches(files);
   if (ISFLAG(a_flags, FA_PRINTUNIQUE)) printunique(files);
diff --git a/jdupes.h b/jdupes.h
index ae03fbe..19a84a4 100644
--- a/jdupes.h
+++ b/jdupes.h
@@ -158,6 +158,7 @@ extern uint64_t flags, a_flags, p_flags;
 #define FA_PRINTNULL		(1U << 9)
 #define FA_PRINTJSON		(1U << 10)
 #define FA_ERRORONDUPE		(1U << 11)
+#define FA_DEDUPECOPYRANGE	(1U << 12)
 
 /* Per-file true/false flags */
 #define FF_VALID_STAT		(1U << 0)
