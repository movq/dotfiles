 act_dedupefiles.c | 134 ++++++++++++++++++++++++++++++++++++++++++++++
 act_dedupefiles.h |   3 ++
 dumpflags.c       |   1 +
 helptext.c        |   4 ++
 jdupes.1          |   8 +++
