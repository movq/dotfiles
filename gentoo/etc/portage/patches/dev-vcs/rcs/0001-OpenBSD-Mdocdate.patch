 #include <string.h>
 #include "b-complain.h"
 #include "b-divvy.h"
@@ -28,6 +29,25 @@
 #include "b-fro.h"
 #include "b-kwxout.h"
 
+static void
+amdocdate (char const *date, FILE *out)
+/* Output an RCS date in the format used by OpenBSD's Mdocdate keyword.  */
+{
+  static char const *const month_name[] =
+    {
+      "January", "February", "March", "April", "May", "June",
+      "July", "August", "September", "October", "November", "December"
+    };
+  char *tail;
+  long year = strtol (date, &tail, 10);
+  long month = strtol (tail + 1, &tail, 10);
+  long day = strtol (tail + 1, NULL, 10);
+
+  if (year < 1900)
+    year += 1900;
+  aprintf (out, "%s %ld %ld", month_name[month - 1], day, year);
+}
+
 static void
 afilename (bool base, FILE *out)
 /* Output to ‘out’ either the full comma-v filename (‘base’ false)
@@ -140,6 +160,9 @@ keyreplace (struct pool_found *marker, struct expctx *ctx)
         case State:
           aputs (delta->state, out);
           break;
+        case Mdocdate:
+          amdocdate (date, out);
+          break;
         default:
           break;
         }
