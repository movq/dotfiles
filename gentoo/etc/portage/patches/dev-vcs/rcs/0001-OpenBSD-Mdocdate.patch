diff --git a/doc/rcs.texi b/doc/rcs.texi
index 8ceefb5..2be45f9 100644
--- a/doc/rcs.texi
+++ b/doc/rcs.texi
@@ -1169,6 +1169,13 @@ the rest of the command-line.  The effective command-line that
 @rcscommand{rlog} sees is thus @samp{-q -x/,v -zLT -L foo}.
 @end defvr
 
+@defvr {Environment Variable} RCS_MDOCDATE
+When set to a nonempty value, @rcscommand{co} recognizes the OpenBSD
+@samp{Mdocdate} keyword and expands it to the revision date in
+@samp{Month D YYYY} format.  When unset or empty, the keyword is left
+unchanged.
+@end defvr
+
 @defvr {Environment Variable} RCS_MEM_LIMIT
 @cindex memory limit
 Normally, for speed, commands either memory map or copy into memory
diff --git a/src/b-anchor.c b/src/b-anchor.c
index a864a9d..36cfe05 100644
--- a/src/b-anchor.c
+++ b/src/b-anchor.c
@@ -19,6 +19,7 @@
 */
 
 #include "base.h"
+#include <stdlib.h>
 #include <string.h>
 
 char const ks_revno[] = "revision number";
@@ -77,9 +78,9 @@ static const uint8_t kwsub_pool[22] =
   1,'b','\0'
 };
 
-static const uint8_t keyword_pool[80] =
+static const uint8_t keyword_pool[90] =
 {
-  11 /* count */,
+  12 /* count */,
   6,'A','u','t','h','o','r','\0',
   4,'D','a','t','e','\0',
   6,'H','e','a','d','e','r','\0',
@@ -90,7 +91,8 @@ static const uint8_t keyword_pool[80] =
   7,'R','C','S','f','i','l','e','\0',
   8,'R','e','v','i','s','i','o','n','\0',
   6,'S','o','u','r','c','e','\0',
-  5,'S','t','a','t','e','\0'
+  5,'S','t','a','t','e','\0',
+  8,'M','d','o','c','d','a','t','e','\0'
 };
 
 static bool
@@ -172,9 +174,17 @@ recognize_keyword (char const *string, struct pool_found *found)
       .size = limit
     };
 
-  return ((KDELIM == string[limit]
-           || VDELIM == string[limit])
-          && pool_lookup (keyword_pool, &x, found));
+  if ((KDELIM != string[limit] && VDELIM != string[limit])
+      || ! pool_lookup (keyword_pool, &x, found))
+    return false;
+
+  if (found->i == Mdocdate)
+    {
+      char const *enabled = getenv ("RCS_MDOCDATE");
+      return enabled && *enabled;
+    }
+
+  return true;
 }
 
 /* b-anchor.c ends here */
