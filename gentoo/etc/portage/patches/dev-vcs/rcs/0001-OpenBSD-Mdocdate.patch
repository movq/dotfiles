+
+. $srcdir/common
+split_std_out_err no
+
+actual=$wd/actual
+expected=$wd/expected
+doubt=$wd/diff.out
+
+RCS_MDOCDATE=
+export RCS_MDOCDATE
+
+sed \
+  -e 's/date	2010.10.02.04.35.26/date	2010.03.07.04.35.26/' \
+  -e 's/@foo/@$Mdocdate$\
+$Mdocdate: stale value $/' \
+  `bundled_commav one` > $v
+
+printf '%s\n' \
+  '$Mdocdate$' \
+  '$Mdocdate: stale value $' > $expected
+must 'co -q -p $v > $actual'
+diff -u $expected $actual > $doubt
+noiselessness_rules $doubt 'Mdocdate expansion disabled by default'
+
+RCS_MDOCDATE=1
+export RCS_MDOCDATE
+
+printf '%s\n' \
+  '$Mdocdate: March 7 2010 $' \
+  '$Mdocdate: March 7 2010 $' > $expected
+must 'co -q -p $v > $actual'
+diff -u $expected $actual > $doubt
+noiselessness_rules $doubt 'Mdocdate single-digit day expansion'
+
+sed 's/2010.03.07/2010.03.17/' $v > $wd/y,v
+printf '%s\n' \
+  '$Mdocdate: March 17 2010 $' \
+  '$Mdocdate: March 17 2010 $' > $expected
+must 'co -q -p $wd/y,v > $actual'
+diff -u $expected $actual > $doubt
+noiselessness_rules $doubt 'Mdocdate double-digit day expansion'
+
+exit 0
+
+# t392 ends here
